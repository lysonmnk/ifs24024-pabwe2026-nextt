{
  "name": "ifs24024-pabwe2026-proyek1",
  "version": "1.0.0",
  "private": true,
  "description": "Catatan Belajar Ngoding - Proyek 1 PABWE 2026 (Frontend)",
  "author": "Lyson Paulus Esar Manik <11S24024>",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "bun run --cwd frontend build && bun -e \"const fs=require('fs'); fs.cpSync('frontend/dist', 'dist', {recursive:true})\"",
    "install:all": "npm install --prefix frontend",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:frontend": "npm run test --prefix frontend",
    "postinstall": "node scripts/cleanup.js || bun scripts/cleanup.js || true"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.7",
    "concurrently": "^9.1.2",
    "jsdom": "^26.0.0",
    "vitest": "^3.0.7"
  }
}
